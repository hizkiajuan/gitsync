<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>GitSync third-party licenses</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 14px/1.5 -apple-system, system-ui, sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; }
  pre { white-space: pre-wrap; font-size: 12px; padding: 1rem; border: 1px solid #8884; border-radius: 6px; }
  li { margin: 0.1rem 0; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>GitSync is MIT licensed. It is built with the following open-source crates.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
